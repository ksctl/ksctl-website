---
import Container from "../shared/Container.astro";
import { measurementUnit as mu } from "@/data/kubmin";

const outputAccents = ["#f0d28a", "#b6d2d8", "#e8b4c0"];

const chartSwatch: Record<string, string> = {
  grid: "var(--color-kubmin-iris)",
  sci: "var(--color-kubmin-energy)",
  sei: "var(--color-kubmin-efficiency)",
};

const chartAria: Record<string, string> = {
  sci: "Conceptual chart: when the region's grid turns greener, grid carbon intensity and SCI both drop together — SCI reflects where the software runs, not just how it runs.",
  sei: "Conceptual chart: in the same moment the grid turns greener, grid carbon intensity drops but SEI stays flat — SEI measures pure software efficiency, independent of the grid.",
};

// light YAML tinting: key before colon, value after
const codeLines = mu.annotation.split("\n").map((line) => {
  const m = line.match(/^(\s*)([^:\s][^:]*):(.*)$/);
  if (m) return { indent: m[1], key: m[2], value: m[3], raw: null };
  return { indent: "", key: null, value: null, raw: line };
});
---

<section id="measurement-unit" class="relative py-28 md:py-36 overflow-hidden km-invert scroll-mt-20">
  <div class="absolute inset-0 km-grain opacity-[0.2] pointer-events-none"></div>

  <Container class="relative z-10">
    <div class="max-w-4xl">
      <span class="km-eyebrow">{mu.label}</span>
      <h2 class="mt-6 text-4xl md:text-6xl leading-[1.05] font-medium" style="color: var(--color-kubmin-base)">
        {mu.heading}<br />
        <span class="km-italic km-grad-gold">{mu.headingAccent}</span>
      </h2>
    </div>

    <div class="mt-16 grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <p class="text-lg md:text-xl leading-relaxed" style="color: rgb(250 244 237 / 0.85)">
          {mu.intro}
        </p>

        <div class="mt-10 km-mono text-xs uppercase tracking-[0.22em]" style="color: rgb(250 244 237 / 0.55)">
          {mu.unitsLabel}
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          {mu.units.map((unit) => (
            <span class="km-mono text-xs px-3.5 py-1.5 rounded-full" style="border: 1px solid rgb(250 244 237 / 0.25); color: rgb(250 244 237 / 0.85); letter-spacing: 0.04em;">
              {unit}
            </span>
          ))}
        </div>

        <p class="mt-10 text-sm leading-relaxed pl-5 border-l-2" style="color: rgb(250 244 237 / 0.7); border-color: #b6d2d8;">
          {mu.sciNote}
        </p>
      </div>

      <div class="lg:col-span-7 min-w-0">
        <div class="km-code">
          <div class="km-code-bar">
            <span>{mu.annotationTitle}</span>
            <span style="letter-spacing: 0.06em; text-transform: none;">{mu.annotationFile}</span>
          </div>
          <pre><code>{codeLines.map((line) => (
            <span class="block whitespace-pre">{line.raw !== null ? (
              <span class="tok-dim">{line.raw}</span>
            ) : (
              <>{line.indent}<span class="tok-key">{line.key}</span><span class="tok-dim">:</span><span class="tok-val">{line.value}</span></>
            )}</span>
          ))}</code></pre>
        </div>

        <a
          href={mu.prLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 km-mono text-xs px-3.5 py-1.5 rounded-full transition-colors hover:[border-color:rgb(250_244_237_/_0.6)] hover:[color:rgb(250_244_237)]"
          style="border: 1px solid rgb(250 244 237 / 0.25); color: rgb(250 244 237 / 0.75); letter-spacing: 0.04em;"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.78 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.66.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.21.67.8.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          {mu.prLink.label}
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>

        <div class="mt-8 km-mono text-xs uppercase tracking-[0.22em]" style="color: rgb(250 244 237 / 0.55)">
          {mu.outputsTitle}
        </div>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-6">
          {mu.outputs.map((out, i) => (
            <div class="pl-4" style={`border-left: 1px solid rgb(250 244 237 / 0.18);`}>
              <div class="km-mono text-lg md:text-xl tabular-nums leading-tight" style={`color: ${outputAccents[i % outputAccents.length]}`}>
                {out.value}
              </div>
              <div class="mt-2 text-xs leading-relaxed" style="color: rgb(250 244 237 / 0.6)">{out.note}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-24 pt-16" style="border-top: 1px solid rgb(250 244 237 / 0.12)">
      <div class="max-w-3xl">
        <h3 class="text-3xl md:text-4xl font-medium leading-[1.1]" style="color: var(--color-kubmin-base)">
          {mu.insightCharts.heading.replace(mu.insightCharts.headingAccent, "")}
          <span class="km-italic km-grad-gold">{mu.insightCharts.headingAccent}</span>
        </h3>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: rgb(250 244 237 / 0.7)">
          {mu.insightCharts.intro}
        </p>
      </div>

      <div class="mt-12 grid lg:grid-cols-2 gap-6">
        {mu.insightCharts.charts.map((chart) => (
          <figure
            class="km-chart km-paper rounded-3xl overflow-hidden flex flex-col"
            x-data
            x-intersect.once="$el.classList.add('is-drawn')"
          >
            <div class="flex items-center justify-between gap-4 px-6 py-4" style="background: var(--color-kubmin-overlay); border-bottom: 1px solid var(--color-kubmin-border);">
              <span class="km-mono text-xs uppercase tracking-[0.22em]" style="color: var(--color-kubmin-text)">{chart.label}</span>
              <span class="km-mono text-xs tracking-[0.06em] px-2.5 py-1 rounded-full" style="background: var(--color-kubmin-muted); color: var(--color-kubmin-primary-700);">{chart.tag}</span>
            </div>

            <div class="px-4 pt-5 sm:px-6">
              <svg viewBox="0 0 640 290" class="w-full h-auto block" role="img" aria-label={chartAria[chart.id]}>
                {[60, 108, 156, 204].map((y) => (
                  <line x1="16" y1={y} x2="624" y2={y} stroke="var(--color-kubmin-subtle)" stroke-width="1" stroke-dasharray="2 7" />
                ))}
                <line x1="16" y1="252" x2="624" y2="252" stroke="var(--color-kubmin-border)" stroke-width="1" />

                <!-- greener grid band -->
                <g class="km-chart-band">
                  <rect x="400" y="24" width="224" height="228" fill="rgb(144 122 169 / 0.08)" />
                  <line x1="400" y1="24" x2="400" y2="252" stroke="var(--color-kubmin-iris)" stroke-width="1" stroke-dasharray="4 5" opacity="0.5" />
                  <text x="412" y="46" class="km-mono" font-size="12" letter-spacing="2" fill="var(--color-kubmin-iris)" style="text-transform: uppercase;">greener grid</text>
                </g>

                <!-- grid carbon intensity (shared context, same shape in both charts) -->
                <path
                  class="km-chart-fill"
                  d="M16,68 C120,66 200,72 320,64 C360,61 380,60 400,62 L400,194 C460,192 520,194 580,190 L624,190"
                  fill="none" stroke="var(--color-kubmin-iris)" stroke-width="1.5" stroke-dasharray="5 5" stroke-linecap="round"
                />

                {chart.id === "sci" ? (
                  <path
                    class="km-chart-line"
                    pathLength="1"
                    d="M16,92 C90,86 150,100 230,84 C300,76 350,98 400,88 L400,206 L460,202 C520,208 560,200 610,204 L624,202"
                    fill="none" stroke="var(--color-kubmin-energy)" stroke-width="2" stroke-linecap="round"
                  />
                ) : (
                  <path
                    class="km-chart-line"
                    pathLength="1"
                    d="M16,132 C90,128 150,136 230,130 C300,126 350,134 400,130 C460,134 540,128 590,132 L624,130"
                    fill="none" stroke="var(--color-kubmin-efficiency)" stroke-width="2" stroke-linecap="round"
                  />
                )}
              </svg>
            </div>

            <div class="px-6 pb-3 pt-2 flex flex-wrap gap-x-5 gap-y-1.5">
              {chart.legend.map((item) => (
                <span class="inline-flex items-center gap-2 km-mono text-xs tracking-[0.08em]" style="color: var(--color-kubmin-subtle-text)">
                  <span
                    class="inline-block w-4 h-0 border-t-2 shrink-0"
                    style={`border-color: ${chartSwatch[item.key]}; ${item.key === "grid" ? "border-top-style: dashed;" : ""}`}
                  ></span>
                  {item.label}
                </span>
              ))}
            </div>

            <figcaption class="km-italic text-sm leading-relaxed px-6 pb-5" style="color: var(--color-kubmin-subtle-text)">
              {chart.caption}
            </figcaption>

            <div class="mt-auto px-6 py-4" style="border-top: 1px solid var(--color-kubmin-border); background: var(--color-kubmin-overlay);">
              <p class="text-sm leading-relaxed" style="color: var(--color-kubmin-text)">
                <span class="km-mono text-[11px] uppercase tracking-[0.2em] mr-2" style="color: var(--color-kubmin-primary-700)">what it tells you</span>
                {chart.takeaway}
              </p>
            </div>
          </figure>
        ))}
      </div>
    </div>
  </Container>
</section>
