---
import Container from "../shared/Container.astro";
import ModernMockup from "./ModernMockup.astro";
import { explore } from "@/data/kubmin";

const [lead, ...rest] = explore.screenshots;
---

<section id="explore" class="relative py-28 md:py-36 overflow-hidden" style="background: var(--color-kubmin-base);">
  <div class="absolute inset-0 km-dotgrid opacity-50 pointer-events-none"></div>

  <Container class="relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 mb-16 items-end">
      <div class="lg:col-span-7">
        <span class="km-eyebrow">{explore.label}</span>
        <h2 class="mt-6 text-4xl md:text-6xl leading-[1.02] font-medium" style="color: var(--color-kubmin-text)">
          {explore.heading}<br/>
          <span class="km-italic km-grad-iris">{explore.headingAccent}</span>
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <p class="text-base leading-relaxed" style="color: var(--color-kubmin-subtle-text)">
          {explore.intro}
        </p>
      </div>
    </div>

    <figure class="max-w-6xl mx-auto">
      <ModernMockup
        imageSrc={lead.src}
        imageAlt={lead.alt}
        browserUrl={lead.browserUrl}
        glowColor="energy"
      />
      <figcaption class="mt-5 km-mono text-xs" style="color: var(--color-kubmin-subtle-text)">
        fig. 01 · {lead.caption}
      </figcaption>
    </figure>

    <div class="mt-12 grid md:grid-cols-2 gap-8 lg:gap-10 max-w-6xl mx-auto">
      {rest.map((s, i) => (
        <figure class="min-w-0">
          <ModernMockup
            imageSrc={s.src}
            imageAlt={s.alt}
            browserUrl={s.browserUrl}
            glowColor="primary"
          />
          <figcaption class="mt-5 km-mono text-xs" style="color: var(--color-kubmin-subtle-text)">
            fig. 0{i + 2} · {s.caption}
          </figcaption>
        </figure>
      ))}
    </div>
  </Container>
</section>
