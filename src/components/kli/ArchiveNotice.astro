---
import Container from "../shared/Container.astro";
import { archive } from "@/data/kli";

const ArrowIcon =
  "M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z";
---

<section class="relative overflow-hidden z-0" id="archive-notice">
  <div class="absolute inset-0 w-full h-full pointer-events-none">
    <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 1440 800">
      <path d="M-100,400 C200,150 400,600 700,300 S1100,500 1540,200" fill="none" stroke="var(--color-kli-primary)" stroke-width="2" opacity="0.18" class="animate-path-drift-1" />
      <path d="M-50,600 C250,350 500,700 800,450 S1200,600 1540,350" fill="none" stroke="var(--color-kli-primary)" stroke-width="1.5" opacity="0.14" class="animate-path-drift-2" />
      <path d="M-100,200 C150,50 450,350 750,150 S1050,300 1540,100" fill="none" stroke="var(--color-kli-accent)" stroke-width="2" opacity="0.15" class="animate-path-drift-3" />
      <path d="M-100,650 C300,500 550,750 850,550 S1150,700 1540,500" fill="none" stroke="var(--color-kli-primary)" stroke-width="1.5" opacity="0.12" class="animate-path-drift-4" />
      <path d="M-100,350 C200,250 500,450 800,350 S1100,250 1540,400" fill="none" stroke="var(--color-kli-ring)" stroke-width="1" opacity="0.13" class="animate-path-drift-5" />
    </svg>
  </div>

  <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-[radial-gradient(ellipse,_var(--color-kli-primary)_0%,_transparent_65%)] opacity-[0.12] pointer-events-none"></div>

  <Container>
    <div class="relative pt-32 md:pt-40 pb-8">

      <!-- Hero -->
      <div class="max-w-4xl mx-auto text-center">
        <div class="hero-stagger hero-stagger-1 inline-flex items-center gap-3 rounded-full border border-kli-border bg-kli-muted px-6 py-3 text-base font-medium text-kli-muted-foreground mb-10">
          <span class="inline-block h-2 w-2 rounded-full bg-kli-muted-foreground/50"></span>
          <span class="font-mono text-sm uppercase tracking-widest">{archive.status}</span>
        </div>

        <h1 class="hero-stagger hero-stagger-2 text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tight leading-[1.05] mb-8">
          <span class="text-kli-foreground">kli is </span>
          <span class="bg-gradient-to-r from-kli-primary to-kli-secondary bg-clip-text text-transparent">archived</span>
          <span class="text-kli-foreground">.</span>
        </h1>

        <p class="hero-stagger hero-stagger-3 text-lg md:text-xl text-kli-muted-foreground leading-relaxed max-w-2xl mx-auto mb-10">
          {archive.lede}
        </p>

        <div class="hero-stagger hero-stagger-4 flex flex-wrap items-center justify-center gap-3">
          {archive.facts.map((fact) => (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-kli-primary/20 bg-kli-primary/[0.06] px-4 py-1.5 text-sm font-medium text-kli-primary/80">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-kli-primary"></span>
              {fact}
            </span>
          ))}
        </div>
      </div>

      <!-- Why -->
      <div class="max-w-6xl mx-auto mt-24">
        <h2 class="text-3xl md:text-4xl font-bold text-kli-foreground text-center mb-4">
          {archive.reasons.heading}
        </h2>
        <p class="text-center text-kli-muted-foreground max-w-2xl mx-auto mb-12">
          {archive.reasons.subheading}
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          {archive.reasons.items.map((reason) => (
            <div class="rounded-2xl border border-kli-border bg-kli-card p-8 shadow-xl transition-all duration-300 hover:border-kli-primary/30 hover:-translate-y-1">
              <h3 class="text-lg font-bold text-kli-foreground mb-3 leading-snug">{reason.title}</h3>
              <p class="text-kli-muted-foreground leading-relaxed">{reason.body}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- What I build now -->
      <div class="max-w-6xl mx-auto mt-28">
        <h2 class="text-3xl md:text-4xl font-bold text-kli-foreground text-center mb-4">
          {archive.now.heading}
        </h2>
        <p class="text-center text-kli-muted-foreground max-w-2xl mx-auto mb-12">
          {archive.now.subheading}
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          {archive.now.items.map((item) => (
            <a
              href={item.href}
              class="group flex flex-col rounded-2xl border border-kli-border bg-kli-card p-8 shadow-xl transition-all duration-300 hover:border-kli-primary/40 hover:-translate-y-1"
            >
              <h3 class="text-xl font-bold text-kli-foreground mb-4 transition-colors group-hover:text-kli-primary">
                {item.name}
              </h3>
              <p class="text-kli-muted-foreground leading-relaxed grow">{item.body}</p>
              <span class="mt-6 inline-flex items-center gap-2 font-semibold text-kli-primary">
                Explore
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d={ArrowIcon} clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- Still using + handover -->
      <div class="max-w-6xl mx-auto mt-28 grid lg:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-kli-border bg-kli-card p-8 shadow-xl">
          <h2 class="text-xl font-bold text-kli-foreground mb-5">{archive.stillUsing.heading}</h2>
          <ul class="space-y-4">
            {archive.stillUsing.items.map((line) => (
              <li class="flex gap-3 text-kli-muted-foreground leading-relaxed">
                <span class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-kli-muted-foreground/40"></span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-kli-primary/30 bg-kli-primary/[0.04] p-8 shadow-xl">
          <h2 class="text-xl font-bold text-kli-foreground mb-3">{archive.maintainer.heading}</h2>
          <p class="text-kli-muted-foreground leading-relaxed mb-7">
            {archive.maintainer.body}
          </p>
          <div class="flex flex-wrap gap-4">
            {archive.maintainer.ctas.map((cta, i) => (
              <a
                href={cta.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "group flex items-center justify-center gap-2 h-13 px-8 rounded-xl font-semibold transition-all duration-300 hover:-translate-y-0.5",
                  i === 0
                    ? "bg-kli-primary text-primary-foreground shadow-lg shadow-kli-primary/25 hover:shadow-xl hover:shadow-kli-primary/35"
                    : "border border-kli-border text-kli-foreground hover:border-kli-primary/40",
                ]}
              >
                {cta.text}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d={ArrowIcon} clip-rule="evenodd" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

    </div>
  </Container>
</section>

<style>
  @keyframes pathDrift1 {
    0%, 100% { transform: translateY(0) translateX(0); }
    25% { transform: translateY(-20px) translateX(10px); }
    50% { transform: translateY(10px) translateX(-15px); }
    75% { transform: translateY(-10px) translateX(5px); }
  }
  @keyframes pathDrift2 {
    0%, 100% { transform: translateY(0) translateX(0); }
    30% { transform: translateY(15px) translateX(-10px); }
    60% { transform: translateY(-20px) translateX(12px); }
  }
  @keyframes pathDrift3 {
    0%, 100% { transform: translateY(0) translateX(0); }
    40% { transform: translateY(-15px) translateX(8px); }
    70% { transform: translateY(12px) translateX(-6px); }
  }
  @keyframes pathDrift4 {
    0%, 100% { transform: translateY(0) translateX(0); }
    35% { transform: translateY(18px) translateX(-12px); }
    65% { transform: translateY(-8px) translateX(10px); }
  }
  @keyframes pathDrift5 {
    0%, 100% { transform: translateY(0) translateX(0); }
    50% { transform: translateY(-12px) translateX(6px); }
  }

  .animate-path-drift-1 { animation: pathDrift1 20s ease-in-out infinite; }
  .animate-path-drift-2 { animation: pathDrift2 25s ease-in-out infinite; }
  .animate-path-drift-3 { animation: pathDrift3 22s ease-in-out infinite; }
  .animate-path-drift-4 { animation: pathDrift4 28s ease-in-out infinite; }
  .animate-path-drift-5 { animation: pathDrift5 18s ease-in-out infinite; }

  .hero-stagger {
    opacity: 0;
    transform: translateY(24px);
    animation: heroSlideUp 0.6s ease-out forwards;
  }
  .hero-stagger-1 { animation-delay: 0.05s; }
  .hero-stagger-2 { animation-delay: 0.15s; }
  .hero-stagger-3 { animation-delay: 0.3s; }
  .hero-stagger-4 { animation-delay: 0.45s; }

  @keyframes heroSlideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-stagger {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .animate-path-drift-1,
    .animate-path-drift-2,
    .animate-path-drift-3,
    .animate-path-drift-4,
    .animate-path-drift-5 {
      animation: none;
    }
  }
</style>
